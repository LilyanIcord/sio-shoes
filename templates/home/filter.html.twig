{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}

<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="container">

<br>
    <h1>{{ subCategory.name }} {{ category.name }}</h1>
    <div class="row">
        {% for product in products %}
        <div class="col-md-3 mt-4">
        <div class="card" style="width: 20vh;">
            {% if product.image %}
                <a href="{{ path('app_home_product_show', {'id': product.id})
                }}"><img src="{{ asset('uploads/images/' ~ product.image) }}"
                class="card-img-top" alt="{{ product.name }}"> </a>
                {% else %}
                    <img src="{{ asset ('uploads/images/no_image_available_500x350.png')
                    }}" class="card-img-top" alt="Placeholder image"
                {% endif %}
                <div class="card-body">
                <a style="text-decoration: none" href="{{ path('app_home_product_show', {'id': product.id}) }}">

                <h5 class="card-title">{{product.name}}</h5> </a>
                <p class="card-text text-truncate">{{ product.description }}</p>
                <h3>{{ product.price }} €</h3>
                <a href="#" class="btn btn-outline-success">Ajouter au panier</a>
                </div>
            </div>
        </div>
{% else %}
    <p>Aucun produit disponible 
{% endfor %}
</div>
<br>
    {{ knp_pagination_render(products,'layouts/pagination_template.html.twig') }}
</div>
{% endblock %}
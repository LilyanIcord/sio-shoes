{% extends 'base.html.twig' %}

{% block title %}Product{% endblock %}

{% block body %}
    <h1>Product</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ product.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ product.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ product.description }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ product.price }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_product_stock_add_history', {'id': product.id}) }}">Afficher l'historique des ajouts au stock</a>
    <br>
        <a class="btn btn-outline-success" href="{{ path('app_product_index') }}">Retourner à la liste</a>

    <br>
    <a class="btn btn-outline_primary" href="{{ path('app_product_edit', {'id':product.id}) }}">Modifier</a>
    <br><br>
    {{ include('product/_delete_form.html.twig') }}
    <br>
    <a class="btn btn-dark" href="{{ path('app_product_index') }}">Retour</a>

{% endblock %}
